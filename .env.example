AUTOACE_USERNAME=autoace
AUTOACE_PASSWORD=replace-with-evaluator-password
AUTOACE_AUTH_SECRET=replace-with-a-long-random-secret
AUTOACE_COOKIE_SECURE=0

# Optional model controls
AUTOACE_TONE_MODEL=onnx-community/Speech-Emotion-Classification-ONNX
AUTOACE_TONE_MODEL_DTYPE=q4
AUTOACE_ENGLISH_ASR_MODEL=onnx-community/whisper-tiny.en
AUTOACE_MULTILINGUAL_ASR_MODEL=onnx-community/whisper-tiny
AUTOACE_ASR_MODEL_DTYPE=q4
AUTOACE_ASR_ENABLED=1
